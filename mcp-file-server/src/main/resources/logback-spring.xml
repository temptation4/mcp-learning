<configuration>
    <!-- No console appender at all - a stdio MCP server's stdout is the
         JSON-RPC protocol stream itself, so any log line printed there
         (which is what Spring Boot's default config does) corrupts every
         message a real client tries to parse. All logging goes to a file
         instead. -->
    <appender name="FILE" class="ch.qos.logback.core.FileAppender">
        <!-- Absolute path - a relative one resolves against whatever working
             directory the launching process uses, which for Claude Desktop
             turned out to be read-only, crashing startup before the server
             ever got to speak MCP at all. -->
        <file>${user.home}/Documents/code/mcp-learning/mcp-file-server/mcp-file-server.log</file>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="FILE"/>
    </root>
</configuration>
